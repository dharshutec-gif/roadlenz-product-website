5:["$","$L13",null,{"route":{"slug":"gps-tracking","label":"Tracking","eyebrow":"GPS Tracking","title":"Explore Tracking","subtitle":"Real-time visibility. Smarter decisions. Always in control.","description":"Track every vehicle with live location and movement context. Bring your fleet, routes and daily operations into one clear view.","desktop":"tracking","mobile":"fleet-map","scene":"/media/solutions/logistics-hero.jpg","icon":"map","indicators":["Live fleet map","Journey context","Web & mobile"],"definition":"GPS tracking connects satellite positioning with cellular data to show vehicle location, movement and status on an interactive fleet map.","uses":"Help operators locate vehicles, review routes and stops, and respond to exceptions. Keep dispatch decisions connected to what is happening on the road.","processTitle":"From vehicle data to smarter decisions.","steps":[{"title":"GPS Device","copy":"Collect location and movement data from the vehicle.","icon":"satellite"},{"title":"Data Transmission","copy":"Send updates over the device’s available mobile network.","icon":"radio"},{"title":"Cloud Processing","copy":"Connect position data to the right vehicle and fleet.","icon":"cloud"},{"title":"View & Act","copy":"Review the live map and take the next operational action.","icon":"monitor"}],"features":[{"title":"Real-time Vehicle Tracking","copy":"Locate connected vehicles and review their latest map positions.","icon":"map"},{"title":"Live Speed & Direction","copy":"Understand how a vehicle is moving with speed and heading context.","icon":"gauge"},{"title":"Route History Playback","copy":"Follow previous journeys through a time-based route replay.","icon":"route"},{"title":"Geo-fencing & Alerts","copy":"Use configured boundaries to identify relevant vehicle movements.","icon":"fence"},{"title":"Stops & Idle Monitoring","copy":"Review stopped periods alongside ignition and trip activity.","icon":"clock"},{"title":"Driver & Vehicle Status","copy":"Keep vehicle identity, driver context and device status together.","icon":"truck"}],"benefitsTitle":"Visibility that improves every operation.","benefits":[{"title":"Improved Fleet Security","copy":"Spot unexpected movement and investigate with location context.","icon":"shield"},{"title":"Higher Operational Efficiency","copy":"Use route and stop information to reduce avoidable delays.","icon":"settings"},{"title":"Better Customer Service","copy":"Give customers more informed updates on vehicle progress.","icon":"users"},{"title":"Data-Driven Decisions","copy":"Ground dispatch and fleet reviews in recorded activity.","icon":"chart"}],"outputTitle":"Visibility that turns data into action.","outputs":[{"title":"Live Tracking Map","copy":"Latest vehicle locations and movement.","kind":"map"},{"title":"Trip Summary","copy":"Distance, duration and trip context.","kind":"status"},{"title":"Route History","copy":"A connected view of the journey.","kind":"route"},{"title":"Speed & Idle Analysis","copy":"Review movement and stationary periods.","kind":"chart"},{"title":"Detailed Reports","copy":"Structured records for operational review.","kind":"table"}],"related":["track-history","live-video","reports"],"ctaTitle":"Ready for complete fleet visibility?","ctaCopy":"See how RoadLenz Tracking can support your fleet operation."}}]
